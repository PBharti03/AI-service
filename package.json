{
  "name": "@b2y/ai-service",
  "version": "1.0.0",
  "description": "Shared AI assistant (Beya) for B2Y applications: global tenant and role/permission access, one provider and model configuration, read-only data, analytics, search and document capabilities, conversation history, server endpoints and a React chat UI and widget.",
  "keywords": [
    "b2y",
    "ai",
    "assistant",
    "beya",
    "text-to-sql",
    "analytics",
    "chat"
  ],
  "author": "B2Y Infy Solutions",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuvakrishna29/AI-service.git"
  },
  "bugs": {
    "url": "https://github.com/yuvakrishna29/AI-service/issues"
  },
  "homepage": "https://github.com/yuvakrishna29/AI-service#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./text-to-sql/postgres": "./src/sql/PostgresSqlValidator.js",
    "./documents/pdf": "./src/documents/PdfText.js",
    "./documents/folder": "./src/documents/FolderDocumentStore.js",
    "./conversations/folder": "./src/conversations/FolderConversationStore.js",
    "./server": "./src/server/Server.js",
    "./ui/react": "./src/ui/react/AssistantChat.js",
    "./ui/react/styles.css": "./src/ui/react/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "lint": "eslint .",
    "verify": "npm run lint",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "libpg-query": "^17.8.2",
    "react": ">=18",
    "unpdf": "^1.9.1"
  },
  "peerDependenciesMeta": {
    "libpg-query": {
      "optional": true
    },
    "unpdf": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "libpg-query": "17.8.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "unpdf": "1.9.1"
  }
}
