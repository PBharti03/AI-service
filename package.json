{
  "name": "@b2y/ai-service",
  "version": "0.7.0",
  "description": "Reusable, application-independent AI assistant for B2Y applications: consumer-supplied context, permissions and capabilities, routing to data, analytics, documents, research or advice, conversation history with retention, provider abstraction and a reusable chat UI.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./text-to-sql/postgres": "./src/sql/PostgresSqlValidator.js",
    "./documents/pdf": "./src/documents/PdfText.js",
    "./documents/folder": "./src/documents/FolderDocumentStore.js",
    "./conversations/folder": "./src/conversations/FolderConversationStore.js",
    "./ui/react": "./src/ui/react/AssistantChat.js",
    "./ui/react/styles.css": "./src/ui/react/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test \"tests/**/*.test.js\"",
    "verify": "npm run lint && npm test"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "libpg-query": "^17.8.2",
    "react": ">=18",
    "unpdf": "^1.9.1"
  },
  "peerDependenciesMeta": {
    "libpg-query": {
      "optional": true
    },
    "unpdf": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "libpg-query": "17.8.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "unpdf": "1.9.1"
  }
}
